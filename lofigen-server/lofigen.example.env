# lofigen-server (our versioned adapter)
LOFIGEN_BIND=127.0.0.1
LOFIGEN_PORT=8787
LOFIGEN_PROTOCOL_VERSION=1
LOFIGEN_WORKER_ID=m5-local
LOFIGEN_STAGING_DIR=/Users/<user>/lofigen/staging
LOFIGEN_RUN_DIR=/Users/<user>/lofigen/run
LOFIGEN_HMAC_KEY_FILE=/Users/<user>/lofigen/.hmac
LOFIGEN_HMAC_WINDOW_SECONDS=300
LOFIGEN_ALLOW_NON_LOOPBACK=false
LOFIGEN_DEVICE=mps
LOFIGEN_LM_BACKEND=mlx
LOFIGEN_MAX_BATCH=1
LOFIGEN_ACESTEP_URL=http://127.0.0.1:8001

# Pinned ACE-Step process (separate process, no model load in PR-1)
ACESTEP_NO_INIT=true
ACESTEP_API_HOST=127.0.0.1
ACESTEP_API_PORT=8001
ACESTEP_DOWNLOAD_SOURCE=huggingface
ACESTEP_TMPDIR=/Users/<user>/lofigen/cache/acestep-tmp
TRITON_CACHE_DIR=/Users/<user>/lofigen/cache/triton
TORCHINDUCTOR_CACHE_DIR=/Users/<user>/lofigen/cache/torchinductor

# Hugging Face Hub 0.36.0 cache isolation (set before import)
HF_HOME=/Users/<user>/lofigen/hf-cache
HF_HUB_CACHE=/Users/<user>/lofigen/hf-cache/hub
HF_XET_CACHE=/Users/<user>/lofigen/hf-cache/xet
