{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lofiever.local/schemas/executor-result.v1.schema.json",
  "title": "Lofiever persistent benchmark adapter sidecar",
  "$comment": "Structural schema only. Run cli.mjs --validate-evidence against the containing manifest, trusted execute config, and pinned output root for terminal evidence.",
  "x-lofiever-validation-scope": "structural-schema-only",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "identity": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configurationSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "durationSeconds": {
          "anyOf": [
            {
              "type": "number",
              "const": 150
            },
            {
              "type": "number",
              "const": 180
            },
            {
              "type": "number",
              "const": 184
            }
          ]
        },
        "batchSizeRequested": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 4
            }
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "warmup",
            "repetition"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "commandSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "requestSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "runId",
        "configurationSha256",
        "durationSeconds",
        "batchSizeRequested",
        "phase",
        "index",
        "attempt",
        "commandSha256",
        "requestSha256"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "peakMemoryBytes": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "energyWh": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "peakMemoryBytes",
        "energyWh"
      ],
      "additionalProperties": false
    },
    "metricUnavailableReason": {
      "type": "object",
      "properties": {
        "peakMemoryBytes": {
          "type": "string",
          "minLength": 1
        },
        "energyWh": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "wallTimeSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "outputFile": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "index",
          "durationSeconds",
          "wallTimeSeconds",
          "outputFile"
        ],
        "additionalProperties": false
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "enum": [
                "executor",
                "measurement",
                "allocation",
                "interrupted",
                "validation"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "allocationFailure": {
              "type": "boolean"
            },
            "detailsSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "category",
            "message",
            "retryable",
            "allocationFailure",
            "detailsSha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "status",
    "metrics",
    "metricUnavailableReason",
    "candidates",
    "error"
  ],
  "additionalProperties": false
}
